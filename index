  const teamHolder = document.getElementById('teamTasksList');
  if(team.length === 0){
    teamHolder.innerHTML = '<div class="empty-col">Não há funcionários cadastrados neste setor.</div>';
  } else {
    teamHolder.innerHTML = teamResults.map(({emp, items})=>{
      let list;
      if(items === null) list = '<div class="empty-col">Não foi possível carregar as tarefas.</div>';
      else if(items.length === 0) list = '<div class="empty-col">Nenhuma tarefa delegada ainda.</div>';
      else list = '<div class="assignee-tasks">' + items.map(it =>
        it.key === editingTaskKey ? taskEditFormHtml(it) : taskCardHtml(it, {showManageActions:true, showDelete:true})
      ).join('') + '</div>';
      return '<div class="assignee-group"><h4>'+escapeHtml(emp.nome)+'</h4>'+list+'</div>';
    }).join('');
  }

  content.querySelectorAll('#personalTasksList [data-action], #teamTasksList [data-action]').forEach(btn=>{
    btn.addEventListener('click', ()=> chefeTaskAction(chefe, btn.dataset.key, btn.dataset.action, btn));
  });

  document.getElementById('delegateForm').addEventListener('submit', async (e)=>{
    e.preventDefault();
    const titulo = document.getElementById('delTitulo').value.trim();
    const funcId = document.getElementById('delFuncionario').value;
    const prazo = document.getElementById('delPrazo').value;
    const descricao = document.getElementById('delDescricao').value.trim();
    const errBox = document.getElementById('delegateError');
    const btn = document.getElementById('btnDelegateSubmit');

    if(!titulo || !funcId || !prazo){
      errBox.textContent = 'Preencha o título, escolha o funcionário e defina um prazo antes de delegar.';
      errBox.style.display = 'block';
      return;
    }
    errBox.style.display = 'none';
    btn.disabled = true;
    btn.textContent = 'Delegando…';

    const {ok} = await createTask(funcId, {titulo, descricao, prazo, criadoPor: chefe.id});
    if(!ok){
      errBox.textContent = 'Não foi possível salvar a tarefa agora. Verifique sua conexão e tente novamente.';
      errBox.style.display = 'block';
      btn.disabled = false;
      btn.textContent = 'Delegar tarefa';
      return;
    }
    renderChefeTasks(chefe);
  });
  document.getElementById('personalForm').addEventListener('submit', async (e)=>{
    e.preventDefault();
    const titulo = document.getElementById('perTitulo').value.trim();
    const prazo = document.getElementById('perPrazo').value;
    const descricao = document.getElementById('perDescricao').value.trim();
    const errBox = document.getElementById('personalError');
    const btn = document.getElementById('btnPersonalSubmit');

    if(!titulo || !prazo){
      errBox.textContent = 'Preencha o que precisa fazer e um prazo antes de adicionar.';
      errBox.style.display = 'block';
      return;
    }
    errBox.style.display = 'none';
    btn.disabled = true;
    btn.textContent = 'Adicionando…';

    const {ok} = await createTask(chefe.id, {titulo, descricao, prazo, criadoPor: chefe.id});
    if(!ok){
      errBox.textContent = 'Não foi possível salvar o lembrete agora. Verifique sua conexão e tente novamente.';
      errBox.style.display = 'block';
      btn.disabled = false;
      btn.textContent = 'Adicionar à agenda';
      return;
    }
    renderChefeTasks(chefe);
  });
}

})();
</script>
</body>
</html>
