    const scaleBtns = [1,2,3,4,5].map(n=>
      '<button type="button" data-q="'+q.id+'" data-v="'+n+'" aria-pressed="false" aria-label="Nota '+n+' de 5">'+n+'</button>'
    ).join('');
    group.innerHTML =
      '<div class="qtext">'+q.text+'</div>'+
      '<div class="scale">'+scaleBtns+'</div>'+
      '<div class="scale-labels"><span>Discordo totalmente</span><span>Concordo totalmente</span></div>';
    questionsHolder.appendChild(group);
  });
  questionsHolder.querySelectorAll('.scale button').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const qid = btn.dataset.q, val = Number(btn.dataset.v);
      currentRatings[qid] = val;
      questionsHolder.querySelectorAll('button[data-q="'+qid+'"]').forEach(b=>{
        b.setAttribute('aria-pressed', b.dataset.v === btn.dataset.v ? 'true' : 'false');
      });
      updateSubmitState();
    });
  });
}
function updateSubmitState(){
  const answered = Object.keys(currentRatings).length;
  submitNote.textContent = answered + ' de ' + questions.length + ' respondidas';
  btnSubmitSurvey.disabled = answered < questions.length;
}
commentInput.addEventListener('input', ()=>{
  charCount.textContent = commentInput.value.length;
});

function enterSurvey(setor){
  currentRatings = {};
  buildQuestions();
  updateSubmitState();
  commentInput.value = '';
  charCount.textContent = '0';
