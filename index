<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SYNDECI 360° — Painel de Acompanhamento de Equipe</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"></script>
<style>
  :root{
    --ink:#F3F8FD;
    --ink-panel:#FFFFFF;
    --ink-panel-2:#EAF3FB;
    --ink-line:#CFE1F0;
    --paper:#EAF3FB;
    --paper-dim:#CFE1F0;
    --paper-ink:#0B2545;
    --gold:#1B5FA8;
    --gold-soft:#4C8FD1;
    --teal:#2E5C94;
    --coral:#6FA8DC;
    --text-hi:#0B2545;
    --text-mid:#3E6690;
    --text-low:#7C97AE;
    --radius:2px;
    --serif:'Fraunces', Georgia, serif;
    --sans:'IBM Plex Sans', system-ui, sans-serif;
    --mono:'IBM Plex Mono', 'Courier New', monospace;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:
      radial-gradient(ellipse at 15% -10%, #DCEBF9 0%, transparent 55%),
      var(--ink);
    color:var(--text-hi);
    font-family:var(--sans);
    min-height:100vh;
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  a{color:inherit;}
  button{font-family:var(--sans);}
  ::selection{background:var(--gold);color:var(--ink);}
  :focus-visible{outline:2px solid var(--gold);outline-offset:3px;}

  .redacted-rule{
    display:flex;gap:6px;align-items:center;margin-bottom:10px;
  }
  .redacted-rule span{
    display:block;height:9px;background:var(--ink-line);border-radius:1px;
  }
  .redacted-rule span:nth-child(1){width:34px;}
  .redacted-rule span:nth-child(2){width:14px;background:var(--gold-soft);opacity:.55;}
  .redacted-rule span:nth-child(3){width:22px;}

  header.topbar{
    display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;
    padding:16px clamp(16px,4vw,48px);
    border-bottom:1px solid var(--ink-line);
    position:sticky;top:0;z-index:20;
    background:rgba(16,24,32,.92);backdrop-filter:blur(6px);
  }
  .brand{display:flex;flex-direction:column;gap:2px;min-width:0;}
  .brand .name{
    font-family:var(--serif);font-weight:700;font-size:19px;letter-spacing:.3px;
    color:#4C8FD1;
  }
  .brand .name em{font-style:normal;color:var(--gold);}
  .brand .sub{font-family:var(--mono);font-size:10.5px;letter-spacing:1.5px;color:var(--text-low);text-transform:uppercase;}
  .whoami{
    display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-family:var(--mono);font-size:12px;color:var(--text-mid);
  }
  .whoami .tag{
    border:1px solid var(--ink-line);padding:4px 9px;border-radius:var(--radius);
    color:var(--gold-soft);letter-spacing:.5px;
  }
  .btn-ghost{
    background:none;border:1px solid var(--ink-line);color:var(--text-mid);
    padding:9px 12px;font-size:12px;border-radius:var(--radius);cursor:pointer;
    font-family:var(--mono);letter-spacing:.4px;min-height:38px;
  }
  .btn-ghost:hover{border-color:var(--gold-soft);color:var(--gold-soft);}

  main{max-width:1080px;margin:0 auto;padding:clamp(28px,5vw,64px) clamp(18px,4vw,48px) 90px;}
  .screen{display:none;}
  .screen.active{display:block;animation:rise .5s ease both;}
  @media (prefers-reduced-motion: reduce){ .screen.active{animation:none;} }
  @keyframes rise{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:translateY(0);}}

  /* ---------- IDENTIFY SCREEN ---------- */
  .hero-line{
    font-family:var(--serif);font-weight:600;
    font-size:clamp(28px,4.2vw,44px);line-height:1.1;max-width:680px;margin:6px 0 8px;
  }
  .hero-line em{font-style:italic;color:var(--gold);}
  .hero-sub{color:var(--text-mid);max-width:560px;font-size:15px;margin-bottom:44px;}

  .card{
    background:var(--ink-panel);
    border:1px solid var(--ink-line);
    border-radius:var(--radius);
    position:relative;
  }
  .id-wrap{display:grid;grid-template-columns:1.1fr .9fr;gap:0;max-width:840px;}
  @media (max-width:720px){.id-wrap{grid-template-columns:1fr;}}
  .id-card{padding:clamp(24px,4vw,42px);}
  .id-card .kicker{font-family:var(--mono);font-size:11px;letter-spacing:2px;color:var(--gold-soft);text-transform:uppercase;margin-bottom:14px;}
  label{display:block;font-size:13px;color:var(--text-mid);margin-bottom:7px;font-family:var(--mono);letter-spacing:.3px;}
  select, textarea{
    width:100%;background:var(--ink-panel-2);border:1px solid var(--ink-line);
    color:var(--text-hi);padding:12px 13px;border-radius:var(--radius);font-size:14.5px;
    font-family:var(--sans);
  }
  select:focus, textarea:focus{border-color:var(--gold-soft);}
  .id-preview{
    margin-top:18px;padding:14px 16px;border:1px dashed var(--ink-line);border-radius:var(--radius);
    font-family:var(--mono);font-size:12.5px;color:var(--text-low);min-height:66px;
    display:flex;flex-direction:column;justify-content:center;gap:4px;
  }
  .id-preview .filled b{color:var(--text-hi);font-weight:500;}
  .id-preview .filled .role-chefe{color:var(--gold);}
  .id-preview .filled .role-func{color:var(--teal);}
  .btn-primary{
    margin-top:20px;width:100%;background:var(--gold);color:#231B0C;border:none;
    padding:13px 16px;font-weight:600;font-size:14px;border-radius:var(--radius);cursor:pointer;
    letter-spacing:.3px;transition:transform .15s ease, background .15s ease;
  }
  .btn-primary:disabled{background:var(--ink-line);color:var(--text-low);cursor:not-allowed;}
  .btn-primary:not(:disabled):hover{background:var(--gold-soft);}
  .btn-primary:not(:disabled):active{transform:scale(.99);}

  .stamp-panel{
    background:
      repeating-linear-gradient(135deg, rgba(27,95,168,.06) 0 2px, transparent 2px 26px),
      var(--ink-panel-2);
    border-left:1px solid var(--ink-line);
    display:flex;align-items:center;justify-content:center;flex-direction:column;gap:14px;padding:30px;
  }
  .stamp{color:var(--gold);opacity:.82;transform:rotate(-9deg);}
  .stamp-caption{font-family:var(--mono);font-size:11px;color:var(--text-low);text-align:center;max-width:200px;letter-spacing:.3px;}

  /* ---------- SURVEY SCREEN ---------- */
  .setor-eyebrow{display:flex;align-items:center;gap:10px;margin-bottom:6px;}
  .setor-eyebrow .dot{width:7px;height:7px;border-radius:50%;background:var(--teal);}
  .setor-eyebrow span{font-family:var(--mono);font-size:11.5px;letter-spacing:2px;color:var(--text-mid);text-transform:uppercase;}

  .survey-card{max-width:760px;padding:clamp(22px,4vw,40px);position:relative;overflow:hidden;}
  .survey-card .stamp-corner{position:absolute;top:-18px;right:-18px;width:110px;height:110px;color:var(--gold);opacity:.14;transform:rotate(-9deg);}
  .qgroup{padding:20px 0;border-bottom:1px solid var(--ink-line);}
  .qgroup:first-of-type{padding-top:6px;}
  .qgroup:last-of-type{border-bottom:none;}
  .qtext{font-family:var(--serif);font-size:17px;font-weight:500;margin-bottom:14px;max-width:520px;}
  .scale{display:flex;gap:8px;flex-wrap:wrap;}
  .scale button{
    width:44px;height:44px;border-radius:50%;border:1px solid var(--ink-line);
    background:transparent;color:var(--text-mid);cursor:pointer;font-family:var(--mono);font-size:14px;
    transition:all .15s ease;
  }
  .scale button:hover{border-color:var(--gold-soft);color:var(--gold-soft);}
  .scale button[aria-pressed="true"]{background:var(--gold);border-color:var(--gold);color:#231B0C;font-weight:600;}
  .scale-labels{display:flex;justify-content:space-between;margin-top:8px;font-size:10.5px;color:var(--text-low);max-width:280px;font-family:var(--mono);}

  .comment-block{margin-top:26px;}
  .comment-block textarea{min-height:90px;resize:vertical;font-family:var(--sans);font-size:14px;}
  .char-count{text-align:right;font-family:var(--mono);font-size:10.5px;color:var(--text-low);margin-top:4px;}

  .submit-row{margin-top:26px;display:flex;align-items:center;gap:16px;flex-wrap:wrap;}
  .submit-row .btn-primary{width:auto;margin-top:0;padding:13px 26px;}
  .submit-note{font-size:12px;color:var(--text-low);font-family:var(--mono);}
  .form-error{color:var(--coral);font-size:13px;font-family:var(--mono);margin-top:10px;}

  details.privacy-note{max-width:760px;margin-top:22px;color:var(--text-mid);font-size:13px;}
  details.privacy-note summary{cursor:pointer;font-family:var(--mono);font-size:11.5px;letter-spacing:1px;color:var(--gold-soft);text-transform:uppercase;}
  details.privacy-note p{margin:12px 0 0;line-height:1.6;max-width:600px;}

  /* ---------- THANKS SCREEN ---------- */
  .thanks-wrap{display:flex;flex-direction:column;align-items:center;text-align:center;padding:60px 0;}
  .thanks-wrap .stamp{width:160px;height:160px;animation:stampIn .5s cubic-bezier(.2,1.4,.4,1) both;}
  @media (prefers-reduced-motion: reduce){ .thanks-wrap .stamp{animation:none;} }
  @keyframes stampIn{0%{opacity:0;transform:scale(2.2) rotate(-9deg);}70%{opacity:1;}100%{opacity:.82;transform:scale(1) rotate(-9deg);}}
  .thanks-title{font-family:var(--serif);font-size:26px;margin:22px 0 8px;}
  .thanks-sub{color:var(--text-mid);max-width:420px;font-size:14.5px;}

  /* ---------- DASHBOARD ---------- */
  .kpi-row{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:26px 0 30px;}
  @media (max-width:640px){.kpi-row{grid-template-columns:1fr;}}
  .kpi{padding:18px 20px;}
  .kpi .label{font-family:var(--mono);font-size:10.5px;letter-spacing:1.5px;color:var(--text-low);text-transform:uppercase;margin-bottom:8px;}
  .kpi .value{font-family:var(--serif);font-size:30px;color:var(--text-hi);}
  .kpi .value.gold{color:var(--gold);}
  .kpi .value.teal{color:var(--teal);}

  .chart-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:16px;margin-bottom:16px;}
  @media (max-width:760px){.chart-grid{grid-template-columns:1fr;}}
  .chart-card{padding:20px 22px 10px;}
  .chart-card h3{font-family:var(--serif);font-weight:600;font-size:16px;margin:0 0 4px;}
  .chart-card .hint{font-size:12px;color:var(--text-low);margin-bottom:10px;}
  .chart-holder{position:relative;height:230px;}
  .chart-holder.tall{height:230px;}

  .comments-card{padding:22px;margin-top:16px;}
  .comments-card h3{font-family:var(--serif);font-size:16px;margin:0 0 14px;}
  .comment-item{
    background:var(--paper);color:var(--paper-ink);border-radius:1px;
    padding:14px 16px;margin-bottom:10px;font-size:13.5px;font-style:italic;position:relative;
  }
  .comment-item .meta{display:block;margin-top:8px;font-family:var(--mono);font-style:normal;font-size:10.5px;color:#5B7C9A;letter-spacing:.3px;}
  .empty-comments{color:var(--text-low);font-size:13px;font-family:var(--mono);}

  .locked{
    padding:44px 30px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:14px;
  }
  .locked .lock-icon{color:var(--gold);opacity:.7;}
  .locked h3{font-family:var(--serif);font-size:19px;margin:0;}
  .locked p{color:var(--text-mid);font-size:13.5px;max-width:420px;margin:0;}
  .locked .progress{font-family:var(--mono);font-size:12px;color:var(--gold-soft);letter-spacing:.5px;}

  .state-msg{font-family:var(--mono);font-size:12.5px;color:var(--text-low);padding:20px 0;}
  .refresh-row{display:flex;justify-content:flex-end;margin-bottom:6px;}

  /* ---------- NAV ROW ---------- */
  .nav-row{display:flex;gap:10px;margin-bottom:24px;}

  /* ---------- MENU SCREEN ---------- */
  .menu-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;max-width:820px;margin-top:8px;}
  @media (max-width:640px){.menu-grid{grid-template-columns:1fr;}}
  button.menu-card{
    display:block;width:100%;margin:0;text-align:left;font-family:inherit;color:inherit;
    cursor:pointer;appearance:none;-webkit-appearance:none;
    padding:30px 26px;transition:border-color .15s ease, transform .15s ease, box-shadow .15s ease;
  }
  button.menu-card:hover{border-color:var(--gold-soft);transform:translateY(-2px);box-shadow:0 8px 20px rgba(27,95,168,.08);}
  .menu-card .icon{color:var(--gold);margin-bottom:18px;}
  .menu-card h3{font-family:var(--serif);font-weight:600;font-size:19px;margin:0 0 8px;color:var(--text-hi);}
  .menu-card p{font-size:13.5px;color:var(--text-mid);margin:0;min-height:36px;}
  .menu-card .arrow{margin-top:18px;font-family:var(--mono);font-size:11.5px;color:var(--gold-soft);letter-spacing:.5px;}

  /* ---------- SENHA OPCIONAL DO PERFIL ---------- */
  .password-row{max-width:820px;margin-top:22px;display:flex;justify-content:flex-start;}
  .icon-btn{
    display:flex;align-items:center;gap:9px;background:none;border:1px dashed var(--ink-line);
    color:var(--text-mid);padding:11px 16px;border-radius:var(--radius);cursor:pointer;
    font-family:var(--mono);font-size:12px;letter-spacing:.3px;transition:border-color .15s ease, color .15s ease;
    text-align:left;white-space:normal;min-height:44px;
  }
  .icon-btn:hover{border-color:var(--gold-soft);color:var(--gold-soft);}
  .icon-btn svg{color:var(--gold-soft);flex-shrink:0;}

  .modal-overlay{
    position:fixed;inset:0;background:rgba(11,37,69,.55);backdrop-filter:blur(2px);
    display:none;align-items:center;justify-content:center;z-index:50;padding:20px;
  }
  .modal-card{width:100%;max-width:400px;max-height:90vh;overflow-y:auto;padding:clamp(22px,4vw,32px);}
  .modal-card h3{font-family:var(--serif);font-weight:600;font-size:19px;margin:0 0 8px;}
  .modal-card .modal-sub{font-size:13px;color:var(--text-mid);margin:0 0 20px;line-height:1.5;}
  .modal-card .field{display:flex;flex-direction:column;gap:6px;margin-bottom:14px;}
  .modal-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:6px;}
  .modal-actions .btn-primary{width:auto;margin-top:0;padding:11px 18px;}

  /* ---------- TASKS: EMPLOYEE COLUMNS ---------- */
  .task-cols{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:10px;}
  @media (max-width:860px){.task-cols{grid-template-columns:1fr;}}
  .task-col-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;}
  .task-col-head h3{font-family:var(--serif);font-weight:600;font-size:15.5px;margin:0;}
  .task-col-head .count{font-family:var(--mono);font-size:11px;color:var(--text-mid);background:var(--ink-panel-2);padding:2px 9px;border-radius:10px;}

  .task-card{padding:16px 18px;margin-bottom:12px;}
  .task-card h4{font-family:var(--sans);font-weight:600;font-size:14.5px;margin:8px 0 6px;color:var(--text-hi);}
  .task-card p.desc{font-size:12.5px;color:var(--text-mid);margin:0 0 10px;line-height:1.5;}
  .task-card .prazo{font-family:var(--mono);font-size:11px;color:var(--gold-soft);letter-spacing:.3px;}
  .task-card .prazo.atrasado{color:var(--text-hi);font-weight:700;}
  .task-card .field{display:flex;flex-direction:column;gap:6px;}
  .task-card .field label{margin-bottom:0;}
  .task-card .task-actions{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap;}
  .task-card .task-actions button{
    font-family:var(--mono);font-size:11px;background:none;border:1px solid var(--ink-line);
    color:var(--text-mid);padding:7px 11px;border-radius:var(--radius);cursor:pointer;
  }
  .task-card .task-actions button:hover{border-color:var(--gold-soft);color:var(--gold-soft);}
  .task-card .task-actions button.primary{background:var(--gold);border-color:var(--gold);color:#fff;}
  .task-card .task-actions button.primary:hover{background:var(--gold-soft);}

  .status-badge{display:inline-block;font-family:var(--mono);font-size:9.5px;letter-spacing:.6px;padding:3px 8px;border-radius:10px;text-transform:uppercase;}
  .status-badge.pendente{background:var(--ink-panel-2);color:var(--text-mid);border:1px solid var(--ink-line);}
  .status-badge.incompleta{background:#CFE1F0;color:var(--gold);border:1px solid #9EC3E4;}
  .status-badge.completa{background:var(--gold);color:#fff;}

  .empty-col{font-family:var(--mono);font-size:12px;color:var(--text-low);padding:14px 0;}

  /* ---------- TASKS: CHEFE AGENDA ---------- */
  .agenda-section{margin-top:34px;}
  .agenda-section:first-of-type{margin-top:10px;}
  .agenda-section h2{font-family:var(--serif);font-weight:600;font-size:20px;margin:0 0 4px;}
  .agenda-section .sub{font-size:13px;color:var(--text-mid);margin:0 0 16px;}

  .task-form{padding:22px 24px;display:grid;grid-template-columns:repeat(4,1fr);gap:14px;align-items:end;}
  @media (max-width:820px){.task-form{grid-template-columns:1fr 1fr;}}
  @media (max-width:480px){.task-form{grid-template-columns:1fr;}}
  .task-form .field{display:flex;flex-direction:column;gap:6px;}
  .task-form .field.wide{grid-column:span 2;}
  @media (max-width:480px){.task-form .field.wide{grid-column:span 1;}}
  .task-form button{grid-column:1/-1;}
  input[type="text"], input[type="date"]{
    width:100%;background:var(--ink-panel-2);border:1px solid var(--ink-line);
    color:var(--text-hi);padding:11px 12px;border-radius:var(--radius);font-size:13.5px;font-family:var(--sans);
  }
  input[type="text"]:focus, input[type="date"]:focus{border-color:var(--gold-soft);}

  .assignee-group{margin-bottom:24px;}
  .assignee-group h4{font-family:var(--mono);font-size:11.5px;letter-spacing:1.5px;text-transform:uppercase;color:var(--gold-soft);margin:0 0 12px;}
  .assignee-tasks{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:12px;}

  footer{
    text-align:center;padding:30px 20px;color:var(--text-low);font-family:var(--mono);font-size:11px;
    border-top:1px solid var(--ink-line);letter-spacing:.4px;
  }

  input[type="text"], input[type="date"], input[type="password"]{
    width:100%;background:var(--ink-panel-2);border:1px solid var(--ink-line);
    color:var(--text-hi);padding:11px 12px;border-radius:var(--radius);font-size:13.5px;font-family:var(--sans);
    min-height:44px;
  }
  input[type="text"]:focus, input[type="date"]:focus, input[type="password"]:focus{border-color:var(--gold-soft);}

  /* ---------- RESPONSIVO GERAL: CELULAR E DESKTOP ---------- */
  html{-webkit-text-size-adjust:100%;text-size-adjust:100%;}
  html, body{overflow-x:hidden;width:100%;}
  img, svg, canvas{max-width:100%;}
  button, a, .scale button, .task-actions button, .menu-card, .icon-btn{-webkit-tap-highlight-color:transparent;}

  /* toques confortáveis em telas de toque */
  .task-card .task-actions button, .btn-ghost, .icon-btn{min-height:40px;}

  @media (max-width:640px){
    main{padding-left:16px;padding-right:16px;}
    .brand .name{font-size:17px;}
    .hero-line{font-size:clamp(24px,7vw,32px);}
    .kpi-row{gap:10px;}
    .task-form{padding:18px;}
  }

  /* evita zoom automático ao focar campos no iOS (exige fonte >=16px) */
  @media (max-width:600px){
    select, textarea, input[type="text"], input[type="date"], input[type="password"]{
      font-size:16px;
    }
  }
</style>
</head>

<body>

<header class="topbar">
  <div class="brand">
    <div class="redacted-rule"><span></span><span></span><span></span></div>
    <div class="name">SYNDECI 360°</div>
    <div class="sub">Painel de Acompanhamento de Equipe</div>
  </div>
  <div class="whoami" id="whoamiBox" style="display:none;">
    <span class="tag" id="whoamiTag">—</span>
    <button class="btn-ghost" id="btnLogout">Trocar identificação</button>
  </div>
</header>

<main>

  <!-- ===================== SCREEN 1: IDENTIFICAÇÃO ===================== -->
  <section class="screen active" id="screen-identify">
    <h1 class="hero-line">Antes de tudo, <em>quem é você</em> hoje?</h1>
    <p class="hero-sub">Selecione seu nome para entrar no painel. A partir do seu cargo, o sistema abre a visão certa: gestores acompanham o clima do setor, e o time avalia de forma anônima como está se sentindo.</p>

    <div class="card id-wrap">
      <div class="id-card">
        <div class="kicker">Identificação</div>
        <label for="employeeSelect">Nome do funcionário</label>
        <select id="employeeSelect">
          <option value="" selected disabled>Selecione seu nome…</option>
        </select>

        <div class="id-preview" id="idPreview">
