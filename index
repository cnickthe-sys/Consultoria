/* ---- FUNCIONÁRIO: três colunas por status ---- */
async function renderEmployeeTasks(emp){
  const content = document.getElementById('tasksContent');
  const items = await fetchTasks(emp.id);
  if(items === null){
    content.innerHTML = '<div class="card locked"><h3>Não foi possível carregar suas tarefas</h3><p>Tente novamente em instantes.</p><button class="btn-ghost" id="btnTasksRetry">Tentar novamente</button></div>';
    document.getElementById('btnTasksRetry').addEventListener('click', ()=>renderEmployeeTasks(emp));
    return;
  }
  const cols = {pendente:[], incompleta:[], completa:[]};
  items.forEach(it=>{ (cols[it.task.status] || cols.pendente).push(it); });

  function colHtml(key, label, arr){
    const body = arr.length ? arr.map(it=>taskCardHtml(it,{showStatusActions:true})).join('') : '<div class="empty-col">Nenhuma tarefa aqui.</div>';
    return '<div><div class="task-col-head"><h3>'+label+'</h3><span class="count">'+arr.length+'</span></div>'+body+'</div>';
  }

  content.innerHTML =
    '<div class="refresh-row"><button class="btn-ghost" id="btnTasksRefresh">Atualizar</button></div>'+
    (items.length===0 ? '<div class="empty-col">Você ainda não tem tarefas atribuídas pelo seu chefe.</div>' :
    '<div class="task-cols">'+
      colHtml('pendente','Pendentes', cols.pendente)+
      colHtml('incompleta','Em andamento', cols.incompleta)+
      colHtml('completa','Concluídas', cols.completa)+
    '</div>');

  document.getElementById('btnTasksRefresh').addEventListener('click', ()=>renderEmployeeTasks(emp));
  content.querySelectorAll('[data-action]').forEach(btn=>{
    btn.addEventListener('click', ()=> handleTaskAction(btn.dataset.key, btn.dataset.action, ()=>renderEmployeeTasks(emp)));
  });
}

/* ---- CHEFE: delegar + agenda pessoal + acompanhamento ---- */
async function chefeTaskAction(chefe, key, action, btn){
  if(action==='edit'){ editingTaskKey = key; renderChefeTasks(chefe); return; }
  if(action==='cancel-edit'){ editingTaskKey = null; renderChefeTasks(chefe); return; }
  if(action==='save-edit'){
    const card = btn.closest('.task-card');
    const titulo = card.querySelector('[data-field="titulo"]').value.trim();
    const prazo = card.querySelector('[data-field="prazo"]').value;
    const descricao = card.querySelector('[data-field="descricao"]').value.trim();
    if(!titulo || !prazo) return;
    let r; try{ r = await window.storage.get(key, true); }catch(e){ return; }
    if(!r) return;
    const task = JSON.parse(r.value);
    task.titulo = titulo; task.prazo = prazo; task.descricao = descricao;
    await saveTask(key, task);
    editingTaskKey = null;
    renderChefeTasks(chefe);
    return;
  }
  await handleTaskAction(key, action, ()=>renderChefeTasks(chefe));
}

