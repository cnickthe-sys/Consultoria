async function loadDashboard(setor){
  dashboardContent.innerHTML = '<div class="state-msg">Carregando respostas do setor…</div>';
  const setorSlug = slugify(setor);
  const prefix = 'avaliacao:' + setorSlug + ':';

  let entries = [];
  try{
    const list = await window.storage.list(prefix, true);
    const keys = (list && list.keys) ? list.keys : [];
    const results = await Promise.all(keys.map(async k=>{
      try{
        const r = await window.storage.get(k, true);
        return r ? JSON.parse(r.value) : null;
      }catch(e){ return null; }
    }));
    entries = results.filter(Boolean);
  }catch(err){
    dashboardContent.innerHTML =
      '<div class="card locked"><h3>Não foi possível carregar os dados</h3>'+
      '<p>Houve um problema ao buscar as avaliações do setor. Tente atualizar novamente.</p>'+
      '<button class="btn-ghost" onclick="location.reload()">Recarregar página</button></div>';
    return;
  }

  renderDashboard(setor, entries);
}

function renderDashboard(setor, entries){
  const count = entries.length;

  if(count < MIN_RESPONSES){
    dashboardContent.innerHTML =
      '<div class="card locked">'+
        '<svg class="lock-icon" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="4" y="10" width="16" height="10" rx="1.5"/><path d="M7 10V7a5 5 0 0 1 10 0v3"/></svg>'+
        '<h3>Aguardando mais respostas</h3>'+
        '<p>Para preservar o anonimato de quem responde, os resultados só ficam visíveis quando o setor atinge pelo menos '+MIN_RESPONSES+' avaliações.</p>'+
        '<div class="progress">'+count+' de '+MIN_RESPONSES+' respostas recebidas</div>'+
      '</div>'+
      '<div class="refresh-row" style="margin-top:14px;"><button class="btn-ghost" id="btnRefresh">Atualizar dados</button></div>';
    document.getElementById('btnRefresh').addEventListener('click', ()=>loadDashboard(setor));
    return;
  }

  // agregações
  const averages = questions.map(q=>{
    const vals = entries.map(e=>e.ratings[q.id]).filter(v=>typeof v === 'number');
    const avg = vals.reduce((a,b)=>a+b,0) / (vals.length || 1);
    return {short:q.short, avg: Math.round(avg*100)/100};
  });

  const overallVals = entries.map(e=>e.ratings['q6']).filter(v=>typeof v === 'number');
  const overallAvg = Math.round((overallVals.reduce((a,b)=>a+b,0)/(overallVals.length||1))*100)/100;

  const distCounts = [1,2,3,4,5].map(n => overallVals.filter(v=>v===n).length);

  const byDate = {};
  entries.slice().sort((a,b)=>a.timestamp-b.timestamp).forEach(e=>{
    const label = new Date(e.timestamp).toLocaleDateString('pt-BR',{day:'2-digit', month:'2-digit'});
    if(!byDate[label]) byDate[label] = [];
    if(typeof e.ratings['q6'] === 'number') byDate[label].push(e.ratings['q6']);
  });
  const trendLabels = Object.keys(byDate);
  const trendValues = trendLabels.map(l=>{
    const arr = byDate[l];
    return Math.round((arr.reduce((a,b)=>a+b,0)/(arr.length||1))*100)/100;
  });

  const comments = entries.filter(e=>e.comentario && e.comentario.length>0)
    .sort((a,b)=>b.timestamp-a.timestamp).slice(0,12);

  dashboardContent.innerHTML = `
    <div class="refresh-row"><button class="btn-ghost" id="btnRefresh">Atualizar dados</button></div>
    <div class="kpi-row">
      <div class="card kpi"><div class="label">Respostas coletadas</div><div class="value gold">${count}</div></div>
      <div class="card kpi"><div class="label">Sentimento geral médio</div><div class="value teal">${overallAvg.toFixed(2)} / 5</div></div>
      <div class="card kpi"><div class="label">Setor</div><div class="value" style="font-size:19px;">${setor}</div></div>
    </div>

    <div class="chart-grid">
      <div class="card chart-card">
        <h3>Média por dimensão</h3>
        <div class="hint">Escala de 1 (discordo totalmente) a 5 (concordo totalmente)</div>
        <div class="chart-holder"><canvas id="chartBar"></canvas></div>
      </div>
      <div class="card chart-card">
        <h3>Distribuição do sentimento</h3>
        <div class="hint">Notas dadas para "sentimento geral"</div>
        <div class="chart-holder"><canvas id="chartDoughnut"></canvas></div>
      </div>
    </div>

    <div class="card chart-card">
      <h3>Tendência do sentimento geral</h3>
      <div class="hint">Média diária das respostas recebidas</div>
      <div class="chart-holder tall"><canvas id="chartLine"></canvas></div>
    </div>

    <div class="card comments-card">
      <h3>Comentários anônimos</h3>
      <div id="commentsList"></div>
    </div>
  `;

  document.getElementById('btnRefresh').addEventListener('click', ()=>loadDashboard(setor));

  const commentsList = document.getElementById('commentsList');
  if(comments.length === 0){
    commentsList.innerHTML = '<div class="empty-comments">Ninguém deixou comentário escrito ainda.</div>';
  } else {
    commentsList.innerHTML = comments.map(c=>
      '<div class="comment-item">“'+c.comentario.replace(/</g,'&lt;')+'”<span class="meta">'+relativeDate(c.timestamp)+' · resposta anônima</span></div>'
    ).join('');
  }

  renderCharts(averages, distCounts, trendLabels, trendValues);
}

function renderCharts(averages, distCounts, trendLabels, trendValues){
  Chart.defaults.font.family = "'IBM Plex Sans', sans-serif";
  Chart.defaults.color = '#3E6690';

  if(charts.bar) charts.bar.destroy();
