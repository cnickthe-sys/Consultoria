   7) MINHAS FUNÇÕES (TAREFAS)
--------------------------------------------------------------- */
const STATUS_LABELS = {pendente:'Pendente', incompleta:'Em andamento', completa:'Concluída'};
let editingTaskKey = null;

function taskKeyPrefix(empId){ return 'tarefa:' + empId + ':'; }

function escapeHtml(s){ return (s||'').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function escapeAttr(s){ return (s||'').replace(/"/g,'&quot;'); }

function formatPrazo(prazo){
  if(!prazo) return 'sem prazo definido';
  const d = new Date(prazo+'T00:00:00');
  if(isNaN(d)) return prazo;
  return d.toLocaleDateString('pt-BR', {day:'2-digit', month:'2-digit', year:'numeric'});
}
function isOverdue(prazo, status){
  if(!prazo || status==='completa') return false;
  const today = new Date(); today.setHours(0,0,0,0);
  const d = new Date(prazo+'T00:00:00');
  return d < today;
}

async function fetchTasks(empId){
  try{
    const list = await window.storage.list(taskKeyPrefix(empId), true);
    const keys = (list && list.keys) ? list.keys : [];
    const results = await Promise.all(keys.map(async k=>{
      try{
        const r = await window.storage.get(k, true);
        return r ? {key:k, task: JSON.parse(r.value)} : null;
      }catch(e){ return null; }
    }));
    return results.filter(Boolean).sort((a,b)=> (a.task.prazo||'9999').localeCompare(b.task.prazo||'9999'));
  }catch(err){ return null; }
}
async function createTask(empId, data){
  const id = Date.now()+'-'+Math.random().toString(36).slice(2,8);
  const key = taskKeyPrefix(empId)+id;
  const task = {
    id, titulo:data.titulo, descricao:data.descricao||'', prazo:data.prazo||'',
    status:'pendente', criadoPor:data.criadoPor, criadoEm:Date.now()
  };
  let ok = false;
  try{
    const result = await window.storage.set(key, JSON.stringify(task), true);
    ok = !!result;
  }catch(e){ ok = false; }
  return {key, task, ok};
}
async function saveTask(key, task){
  task.atualizadoEm = Date.now();
  let ok = false;
  try{
    const result = await window.storage.set(key, JSON.stringify(task), true);
    ok = !!result;
  }catch(e){ ok = false; }
  return ok;
}
async function handleTaskAction(key, action, onChange){
  if(action==='delete'){
    try{ await window.storage.delete(key, true); }catch(e){}
    onChange();
    return;
  }
  let r;
  try{ r = await window.storage.get(key, true); }catch(e){ return; }
  if(!r) return;
  const task = JSON.parse(r.value);
  if(action==='advance'){ task.status = task.status==='pendente' ? 'incompleta' : 'completa'; }
  else if(action==='revert'){ task.status = 'pendente'; }
  else if(action==='reopen'){ task.status = 'incompleta'; }
  await saveTask(key, task);
  onChange();
}

function taskCardHtml(it, opts){
  opts = opts || {};
  const t = it.task;
  const overdue = isOverdue(t.prazo, t.status);
  const descHtml = t.descricao ? '<p class="desc">'+escapeHtml(t.descricao)+'</p>' : '';
  let actions = '';
  if(opts.showStatusActions){
    if(t.status==='pendente') actions += '<button data-action="advance" data-key="'+it.key+'" class="primary">Iniciar</button>';
    if(t.status==='incompleta'){
      actions += '<button data-action="advance" data-key="'+it.key+'" class="primary">Concluir</button>';
      actions += '<button data-action="revert" data-key="'+it.key+'">Voltar a pendente</button>';
    }
    if(t.status==='completa') actions += '<button data-action="reopen" data-key="'+it.key+'">Reabrir</button>';
  }
  if(opts.showManageActions) actions += '<button data-action="edit" data-key="'+it.key+'">Editar</button>';
  if(opts.showDelete) actions += '<button data-action="delete" data-key="'+it.key+'">Excluir</button>';

  return '<div class="card task-card">'+
      '<span class="status-badge '+t.status+'">'+STATUS_LABELS[t.status]+'</span>'+
      '<h4>'+escapeHtml(t.titulo)+'</h4>'+
      descHtml+
      '<div class="prazo'+(overdue?' atrasado':'')+'">'+(overdue?'⚠ Atrasada · ':'')+'Prazo: '+formatPrazo(t.prazo)+'</div>'+
      (actions ? '<div class="task-actions">'+actions+'</div>' : '')+
    '</div>';
}
function taskEditFormHtml(it){
  const t = it.task;
  return '<div class="card task-card">'+
      '<div class="field" style="margin-bottom:10px;"><label>Título</label><input type="text" data-field="titulo" value="'+escapeAttr(t.titulo)+'"></div>'+
      '<div class="field" style="margin-bottom:10px;"><label>Prazo</label><input type="date" data-field="prazo" value="'+(t.prazo||'')+'"></div>'+
      '<div class="field" style="margin-bottom:10px;"><label>Notas</label><input type="text" data-field="descricao" value="'+escapeAttr(t.descricao||'')+'"></div>'+
      '<div class="task-actions">'+
        '<button data-action="save-edit" data-key="'+it.key+'" class="primary">Salvar</button>'+
        '<button data-action="cancel-edit" data-key="'+it.key+'">Cancelar</button>'+
      '</div>'+
    '</div>';
}

